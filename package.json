{
  "name": "fbsim-desktop",
  "version": "1.0.0-beta.2",
  "description": "A desktop american football simulation user interface built atop the fbsim-core Rust crate",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "dev": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build": "electron-forge package",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@whatsacomputertho/fbsim-ui": "^1.0.0-beta.2",
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-deb": "^7.6.0",
    "@electron-forge/maker-rpm": "^7.6.0",
    "@electron-forge/maker-squirrel": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-vite": "^7.6.0",
    "@eslint/js": "^9.0.0",
    "electron": "^40.2.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whatsacomputertho/fbsim-desktop.git"
  },
  "keywords": [
    "Football",
    "Simulation",
    "Analytics",
    "Desktop"
  ],
  "author": "whatsacomputertho",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/whatsacomputertho/fbsim-desktop/issues"
  },
  "homepage": "https://github.com/whatsacomputertho/fbsim-desktop#readme"
}
